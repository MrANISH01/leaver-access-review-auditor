# Copy this file to ".env.local" and edit the copy. Never put secrets in here.
# After changing a value, stop the dev server (Ctrl+C) and run "npm run dev" again.

# demo = built-in synthetic data, works without any backend
# live = call the Flask API (not connected yet in Milestone 1)
VITE_DATA_MODE=demo

# Backend API base URL.
# 127.0.0.1 only works when the backend runs on the SAME computer as the frontend.
# For a backend on your teammate's Mac, use the Mac's network address instead.
VITE_API_BASE_URL=http://127.0.0.1:5001/api/v1

# Demo mode only: try out screen states on the Findings and Requests pages.
# normal (default) | empty (no data) | error (simulated load failure) | slow (3 second delay)
# save-error = pages load normally, but submitting or deciding a request fails
VITE_MOCK_SCENARIO=normal
